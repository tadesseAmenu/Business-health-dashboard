<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_expense_tracker_entry_tree" model="ir.ui.view">
        <field name="name">expense.tracker.entry.tree</field>
        <field name="model">expense.tracker.entry</field>
        <field name="arch" type="xml">
            <tree string="Expenses" default_order="date desc">
                <field name="date"/>
                <field name="name"/>
                <field name="category"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_expense_tracker_entry_form" model="ir.ui.view">
        <field name="name">expense.tracker.entry.form</field>
        <field name="model">expense.tracker.entry</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id" groups="base.group_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" placeholder="Add details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_expense_tracker_entry_kanban" model="ir.ui.view">
        <field name="name">expense.tracker.entry.kanban</field>
        <field name="model">expense.tracker.entry</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category">
                <field name="name"/>
                <field name="category"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="text-muted"><field name="category"/></div>
                            <div><field name="date"/></div>
                            <div class="mt-2"><field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                            <div class="text-muted mt-1">Owner: <field name="user_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_expense_tracker_entry_search" model="ir.ui.view">
        <field name="name">expense.tracker.entry.search</field>
        <field name="model">expense.tracker.entry</field>
        <field name="arch" type="xml">
            <search string="Search Expenses">
                <field name="name"/>
                <field name="category"/>
                <field name="date"/>
                <filter name="group_by_category" string="Category" context="{'group_by': 'category'}"/>
                <filter name="group_by_month" string="Month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <!-- Graph view -->
    <record id="view_expense_tracker_entry_graph" model="ir.ui.view">
        <field name="name">expense.tracker.entry.graph</field>
        <field name="model">expense.tracker.entry</field>
        <field name="arch" type="xml">
            <graph string="Expense Analysis" type="bar">
                <field name="date" type="row" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="view_expense_tracker_entry_pivot" model="ir.ui.view">
        <field name="name">expense.tracker.entry.pivot</field>
        <field name="model">expense.tracker.entry</field>
        <field name="arch" type="xml">
            <pivot string="Expense Pivot">
                <field name="date" type="row" interval="month"/>
                <field name="category" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="action_expense_tracker_entry" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">expense.tracker.entry</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_expense_tracker_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first expense entry</p>
        </field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_expense_tracker_root" name="Business Health" sequence="10"/>
    <menuitem id="menu_expense_tracker_entries" name="Expenses" parent="menu_expense_tracker_root" action="action_expense_tracker_entry" sequence="20"/>
</odoo>