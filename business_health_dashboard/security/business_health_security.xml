<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_business_health_manager" model="res.groups">
        <field name="name">Business Health Manager</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_expense_entry_user_own" model="ir.rule">
        <field name="name">Expense Entry: own records</field>
        <field name="model_id" ref="model_expense_tracker_entry"/>
        <field name="domain_force">[("user_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_expense_entry_manager_all" model="ir.rule">
        <field name="name">Expense Entry: manager all records</field>
        <field name="model_id" ref="model_expense_tracker_entry"/>
        <field name="domain_force">[(1, "=", 1)]</field>
        <field name="groups" eval="[(4, ref('business_health_dashboard.group_business_health_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_business_revenue_user_own" model="ir.rule">
        <field name="name">Business Revenue: own records</field>
        <field name="model_id" ref="model_business_revenue"/>
        <field name="domain_force">[("user_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_business_revenue_manager_all" model="ir.rule">
        <field name="name">Business Revenue: manager all records</field>
        <field name="model_id" ref="model_business_revenue"/>
        <field name="domain_force">[(1, "=", 1)]</field>
        <field name="groups" eval="[(4, ref('business_health_dashboard.group_business_health_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
